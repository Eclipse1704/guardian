# Required: meeting analysis (Claude)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional: server-side Hebrew transcription (any OpenAI-compatible /audio/transcriptions endpoint).
# Without it, the browser's live speech recognition (Chrome) is used during recording.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional: automatic WhatsApp sending via Twilio. Without it, the app opens WhatsApp with wa.me links.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# PORT=3000
# DATA_DIR=./data
