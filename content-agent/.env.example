# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; default is claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# --- Higgsfield (product images) ---
# Create a key at https://cloud.higgsfield.ai -> API keys
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Model route on api.higgsfield.ai
HF_IMAGE_MODEL=higgsfield-ai/soul/v2/standard

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Your personal number, international format without "+" (e.g. 9725XXXXXXXX)
WHATSAPP_TO=
WHATSAPP_API_VERSION=v23.0
# "template" works any time (needs an approved template with one body variable {{1}});
# "text" only works within 24h of your last message to the business number.
WHATSAPP_MODE=template
WHATSAPP_TEMPLATE_NAME=daily_digest
WHATSAPP_TEMPLATE_LANG=he

# --- Server / scheduler ---
PORT=8080
# Shared secret your platform sends in the "x-webhook-secret" header
EVENTS_WEBHOOK_SECRET=change-me
# Daily digest time (cron, server local time zone)
DIGEST_CRON=0 20 * * *
TZ=Asia/Jerusalem

# --- Platform ---
# Brand profile injected into every job (empty to disable)
BRAND_FILE=brand/gan-eden-hai.md
# Public URL of this server, used for business-card links (e.g. https://agent.gan-eden-hai.com)
PUBLIC_URL=
